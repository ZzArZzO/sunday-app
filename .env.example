# --- Database ---
POSTGRES_USER=sunday
POSTGRES_PASSWORD=sunday_dev_only_change_me
POSTGRES_DB=sunday
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sunday:sunday_dev_only_change_me@localhost:5432/sunday

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Production: whitelist exact web origins only (e.g. https://app.yourdomain.com).
# Never use a wildcard with credentialed CORS.
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Security (set these in production) ---
# auth_required defaults to true in code; set false locally for single-user dev.
AUTH_REQUIRED=false
# Set true when serving the session cookie over HTTPS (production).
COOKIE_SECURE=false
# Set false in tests/benchmarks that hammer the auth endpoints.
RATE_LIMIT_ENABLED=true

# --- Error tracking (optional; empty = Sentry disabled) ---
SENTRY_DSN=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# API_INTERNAL_URL is set automatically by docker-compose (http://api:8000); only override for custom setups

# --- AI (powers the /assistant chat; leave blank to disable it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_REGION=eu
# Optional: Anthropic EU regional endpoint for data residency (set before launch).
ANTHROPIC_BASE_URL=
# Optional model overrides (defaults: Sonnet for chat, Haiku for the guardrail tier).
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_GUARD_MODEL=claude-haiku-4-5

# --- Market data (not used in the slice yet — populate later) ---
FMP_API_KEY=
# OpenFIGI maps ISIN → market symbol so ISIN-only holdings (DEGIRO) can be priced.
# Optional: works without a key (rate-limited); a key raises limits. openfigi.com/api
OPENFIGI_API_KEY=

# --- Email delivery (Resend; empty key → dry-run, renders but doesn't send) ---
RESEND_API_KEY=
# Use a verified sender on your own domain in production — example.com will bounce.
EMAIL_FROM=Sunday <briefing@example.com>

# --- Stripe billing (leave blank to disable; endpoints return 503) ---
# Use a RESTRICTED key (rk_…), least-privilege — never a secret key (sk_…) in source.
STRIPE_API_KEY=
# Webhook signing secret (whsec_…); from `stripe listen` in dev or the Dashboard.
STRIPE_WEBHOOK_SECRET=
# Price ID (price_…) for the Pro €9/mo plan, created in the Stripe Dashboard.
STRIPE_PRICE_PRO=

# --- Live import connectors (Pro-only; empty → that source returns 503) ---
# Crypto wallet address sync. Default vendor is Zerion (one call covers EVM +
# Solana); get a key at zerion.io/api. Set CRYPTO_INDEXER_PROVIDER=http to use a
# generic indexer instead (then point CRYPTO_INDEXER_BASE_URL at it).
CRYPTO_INDEXER_API_KEY=
CRYPTO_INDEXER_PROVIDER=zerion
CRYPTO_INDEXER_BASE_URL=https://api.zerion.io/v1
# Read-only exchange API-key sync (Bitvavo / Kraken / Coinbase / Binance via CCXT).
# Fernet key used to encrypt stored exchange secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_SECRET_KEY=
